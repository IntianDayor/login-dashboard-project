# Optional integrations for local development. Docker Compose's local database
# settings are defined in docker-compose.yml and are separate from these values.

# Cloudflare R2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# SendGrid:
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
CONTACT_EMAIL=

# Managed database only.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL_CA=
